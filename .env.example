NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI-compatible chat completions endpoint (DeepSeek by default)
AI_API_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=your-deepseek-or-openai-key
AI_MODEL=deepseek-chat

NEXT_PUBLIC_APP_URL=http://localhost:3000

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Optional. If omitted, Checkout bills $15/mo via price_data.
STRIPE_PRO_PRICE_ID=price_xxx

# Gumroad Ping URL:
# https://your-domain.com/api/webhook/gumroad?secret=your-shared-secret
GUMROAD_WEBHOOK_SECRET=your-shared-secret
